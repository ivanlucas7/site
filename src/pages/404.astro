---
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
---

<Base titulo="Página não encontrada">
  <div class="container secao">
    <h1>Página não encontrada</h1>
    <p class="texto-suave">O endereço acessado não existe ou foi movido.</p>
    <p><a class="botao" href={url()}>Voltar ao início</a> <a class="botao botao-secundario" href={url('materiais/')}>Ver materiais</a></p>
  </div>
</Base>
