---
import { SITE, SECOES } from '../data/site';
import { url } from '../data/url';

const itens = [{ titulo: 'Início', href: '' }, ...SECOES.filter((s) => s.disponivel)];
const atual = Astro.url.pathname;
const ativo = (href: string) => {
  const alvo = url(href);
  return href === '' ? atual === alvo : atual.startsWith(alvo);
};
---

<header class="cabecalho">
  <div class="container cabecalho-interno">
    <a class="marca" href={url()}>
      <span class="marca-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"></path></svg>
      </span>
      <span class="marca-texto">
        <strong>{SITE.titulo}</strong>
        <span>{SITE.autor} · {SITE.instituicao}</span>
      </span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          itens.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={ativo(item.href) ? 'page' : undefined}>
                {item.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    background: var(--cor-superficie);
    border-bottom: 1px solid var(--cor-borda);
  }

  .cabecalho-interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--cor-texto);
    min-width: 0;
  }

  .marca-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: var(--cor-primaria);
    color: var(--cor-superficie);
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .marca-texto strong {
    font-size: 1.05rem;
  }

  .marca-texto span {
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    color: var(--cor-texto-suave);
  }

  nav a:hover {
    background: var(--cor-primaria-suave);
    color: var(--cor-primaria-forte);
  }

  nav a[aria-current='page'] {
    background: var(--cor-primaria-suave);
    color: var(--cor-primaria-forte);
  }
</style>
